---
import { PAGES, type SitelinkPage } from "@/lib/site";

type Props = { page: SitelinkPage };

const route = PAGES[Astro.props.page];
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-6 pt-6 text-sm text-[#94a3b8]">
  <ol class="flex items-center gap-2">
    <li>
      <a href="/" class="hover:text-[#00e5ff]">Home</a>
    </li>
    <li aria-hidden="true">/</li>
    <li aria-current="page" class="text-[#f0f4f8]">{route.label}</li>
  </ol>
</nav>
<h1 class="sr-only">{route.label}</h1>
