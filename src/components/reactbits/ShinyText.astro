---
type Props = { text: string };
const { text } = Astro.props;
---

<span class="inline-grid text-(--cyan) *:[grid-area:1/1]" data-reactbits="shiny-text"><span>{text}</span><span class="pointer-events-none hidden select-none motion-safe:supports-[background-clip:text]:inline motion-safe:supports-[background-clip:text]:after:animate-text-shine motion-safe:supports-[background-clip:text]:after:bg-[linear-gradient(110deg,transparent_40%,#fff9_50%,transparent_60%)] motion-safe:supports-[background-clip:text]:after:bg-[length:250%_100%] motion-safe:supports-[background-clip:text]:after:bg-clip-text motion-safe:supports-[background-clip:text]:after:content-[attr(data-text)] motion-safe:supports-[background-clip:text]:after:[-webkit-text-fill-color:transparent]" data-text={text} aria-hidden="true"></span></span>
