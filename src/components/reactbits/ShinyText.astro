---
type Props = { text: string };
const { text } = Astro.props;
---

<span class="shiny-text" data-reactbits="shiny-text"><span>{text}</span><span class="shiny-text-sweep" data-text={text} aria-hidden="true"></span></span>

<style>
  @layer components {
    .shiny-text {
      display: inline-grid;
      color: var(--cyan);
    }

    .shiny-text > span {
      grid-area: 1 / 1;
    }

    .shiny-text-sweep {
      display: none;
      pointer-events: none;
      user-select: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports (background-clip: text) {
        .shiny-text-sweep {
          display: inline;
        }

        .shiny-text-sweep::after {
          content: attr(data-text);
          background: linear-gradient(110deg, transparent 40%, #fff9 50%, transparent 60%);
          background-size: 250% 100%;
          background-clip: text;
          -webkit-text-fill-color: transparent;
          animation: text-shine 6s ease-in-out infinite;
        }
      }
    }

    @keyframes text-shine {
      0%, 25% { background-position: 200% 0; }
      75%, 100% { background-position: -200% 0; }
    }
  }
</style>
