---
import CloudCTA from "@/components/CloudCTA.astro";
import Comparison from "@/components/Comparison";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero";
import HowItWorks from "@/components/HowItWorks";
import Navbar from "@/components/Navbar";
import Packages from "@/components/Packages";
import Partners from "@/components/Partners.astro";
import ScrollAnimation from "@/components/ScrollAnimation";
import WhyUs from "@/components/WhyUs";
import Base from "@/layouts/Base.astro";
import { homeHead } from "@/lib/seo";
---

<Base head={homeHead()}>
  <div class="relative">
    <div class="relative z-10">
      <Navbar client:load pathname="/" />
      <main id="content" tabindex="-1">
        <Hero client:load />
        <ScrollAnimation client:idle />
        <HowItWorks client:visible={{ rootMargin: "200px" }} />
        <Packages client:visible={{ rootMargin: "200px" }} />
        <Comparison client:visible={{ rootMargin: "200px" }} />
        <CloudCTA />
        <WhyUs client:visible={{ rootMargin: "200px" }} />
        <Partners />
        <Contact />
      </main>
      <Footer />
    </div>
  </div>
</Base>
