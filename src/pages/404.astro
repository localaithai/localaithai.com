---
import Base from "@/layouts/Base.astro";
import { homeHead } from "@/lib/seo";

// The Next.js export had no custom not-found page: it served the framework's
// default 404 under the home page head plus a noindex robots tag.
const head = { ...homeHead(), noindex: true };
---

<Base
  head={head}
  documentTitle="404: This page could not be found."
  bodyColors="bg-white text-black dark:bg-black dark:text-white"
>
  <div
    class="flex h-screen flex-col items-center justify-center text-center font-[family-name:system-ui,'Segoe_UI',Roboto,Helvetica,Arial,sans-serif,'Apple_Color_Emoji','Segoe_UI_Emoji']"
  >
    <div>
      <h1
        class="mr-5 inline-block border-r border-r-[rgba(0,0,0,.3)] pr-[23px] align-top text-[24px] leading-[49px] font-medium dark:border-r-[rgba(255,255,255,.3)]"
      >
        404
      </h1>
      <div class="inline-block">
        <h2 class="text-[14px] leading-[49px] font-normal">
          This page could not be found.
        </h2>
      </div>
    </div>
  </div>
</Base>
