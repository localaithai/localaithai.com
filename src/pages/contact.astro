---
import Contact from "@/components/Contact.astro";
import DataRoadBg from "@/components/DataRoadBg";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar";
import SitelinkTrail from "@/components/SitelinkTrail.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Base from "@/layouts/Base.astro";
import { pageMetadata } from "@/lib/seo";
import { nextPathname, PAGES } from "@/lib/site";
import { pageGraph } from "@/lib/structured-data";

const page = PAGES.contact;
---

<Base head={pageMetadata(page)}>
  <main class="relative">
    <JsonLd data={pageGraph(page)} />
    <DataRoadBg client:idle />
    <div class="relative z-10">
      <Navbar client:load pathname={nextPathname(Astro.url.pathname)} />
      <SitelinkTrail page="contact" />
      <div class="pt-20"></div>
      <Contact />
      <Footer />
    </div>
  </main>
</Base>
