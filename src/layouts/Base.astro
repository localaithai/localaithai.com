---
import OmniToaster from "@/components/OmniToaster";
import PageTransition from "@/components/PageTransition";
import JsonLd from "@/components/seo/JsonLd.astro";
import type { PageHead } from "@/lib/seo";
import { SITE_NAME } from "@/lib/site";
import { organizationGraph } from "@/lib/structured-data";
import "@/styles/global.css";

type Props = {
  head: PageHead;
  /** Replaces the head title only, as the Next.js not-found page did. */
  documentTitle?: string;
};

const { head, documentTitle } = Astro.props;
const { openGraph: og, twitter } = head;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="th" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" type="text/plain" href="/llms.txt" />
    <slot name="head" />
    {head.noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="theme-color" content="#060a14" />
    <title>{documentTitle ?? head.title}</title>
    <meta name="description" content={head.description} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="author" content={SITE_NAME} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta
      name="keywords"
      content="Local AI Thailand,AI ส่วนตัว,PDPA,Mimir Suites,AI ในองค์กร"
    />
    <meta name="creator" content={SITE_NAME} />
    <meta name="publisher" content={SITE_NAME} />
    <meta name="robots" content="index, follow" />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />
    <meta name="category" content="technology" />
    <link rel="canonical" href={head.canonical} />
    {
      Object.entries(head.languages ?? {}).map(([lang, href]) => (
        <link rel="alternate" hreflang={lang} href={href} />
      ))
    }
    {
      googleVerification ? (
        <meta name="google-site-verification" content={googleVerification} />
      ) : null
    }
    {
      bingVerification ? (
        <meta name="msvalidate.01" content={bingVerification} />
      ) : null
    }
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:url" content={og.url} />
    <meta property="og:site_name" content={og.siteName} />
    <meta property="og:locale" content={og.locale} />
    {
      og.images.map((image) => (
        <>
          <meta property="og:image" content={image.url} />
          {image.width ? (
            <meta property="og:image:width" content={String(image.width)} />
          ) : null}
          {image.height ? (
            <meta property="og:image:height" content={String(image.height)} />
          ) : null}
          {image.alt ? (
            <meta property="og:image:alt" content={image.alt} />
          ) : null}
        </>
      ))
    }
    <meta property="og:type" content={og.type} />
    {
      og.publishedTime ? (
        <meta property="article:published_time" content={og.publishedTime} />
      ) : null
    }
    {
      og.modifiedTime ? (
        <meta property="article:modified_time" content={og.modifiedTime} />
      ) : null
    }
    <meta name="twitter:card" content={twitter.card} />
    <meta name="twitter:title" content={twitter.title} />
    <meta name="twitter:description" content={twitter.description} />
    {twitter.images.map((url) => <meta name="twitter:image" content={url} />)}
    {/* The query string is the Next.js build hash, kept so cached favicon URLs stay valid. */}
    <link
      rel="icon"
      href="/favicon.ico?favicon.0b3bf435.ico"
      sizes="256x256"
      type="image/x-icon"
    />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      sizes="180x180"
      type="image/png"
    />
  </head>
  <body class="antialiased">
    <JsonLd data={organizationGraph()} />
    <PageTransition client:load>
      <slot />
    </PageTransition>
    <OmniToaster client:idle />
    <script is:inline src="https://localai-omni.vercel.app/cta.js" defer></script>
    <script
      is:inline
      src="https://localai-omni.vercel.app/analytics.js"
      defer></script>
  </body>
</html>
