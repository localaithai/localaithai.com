---
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar";
import Base from "@/layouts/Base.astro";
import type { PageHead } from "@/lib/seo";
import { nextPathname } from "@/lib/site";

type Props = { head: PageHead };

const { head } = Astro.props;
---

<Base head={head}>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    href="/blog/feed.xml"
    title="RSS"
  />
  <Navbar client:load pathname={nextPathname(Astro.url.pathname)} />
  <main id="content" tabindex="-1" style={{ paddingTop: "5rem" }}>
    <slot />
  </main>
  <Footer />
</Base>
